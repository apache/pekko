# The Java API of AbstractShardAllocationStrategy no longer leaks Scala types: allocateShard and
# rebalance now return a java.util.concurrent.CompletionStage instead of a scala.concurrent.Future,
# and the current shard allocations are passed as a java.util.Map of java.util.List shard ids
# instead of scala.collection.immutable.IndexedSeq. Java implementations of the two abstract methods
# have to be updated; this is in line with the other Java API cleanups done for Pekko 2.0.0.
ProblemFilters.exclude[IncompatibleResultTypeProblem]("org.apache.pekko.cluster.sharding.ShardCoordinator#AbstractShardAllocationStrategy.allocateShard(org.apache.pekko.actor.ActorRef,java.lang.String,java.util.Map)scala.concurrent.Future")
ProblemFilters.exclude[IncompatibleResultTypeProblem]("org.apache.pekko.cluster.sharding.ShardCoordinator#AbstractShardAllocationStrategy.rebalance(java.util.Map,java.util.Set)scala.concurrent.Future")
ProblemFilters.exclude[ReversedMissingMethodProblem]("org.apache.pekko.cluster.sharding.ShardCoordinator#AbstractShardAllocationStrategy.allocateShard(org.apache.pekko.actor.ActorRef,java.lang.String,java.util.Map)java.util.concurrent.CompletionStage")
ProblemFilters.exclude[ReversedMissingMethodProblem]("org.apache.pekko.cluster.sharding.ShardCoordinator#AbstractShardAllocationStrategy.rebalance(java.util.Map,java.util.Set)java.util.concurrent.CompletionStage")
