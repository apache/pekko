# Widen javadsl function parameters with wildcard bounds (generic signature only, erasure unchanged)
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.Flow.mapConcat(org.apache.pekko.japi.function.Function)org.apache.pekko.stream.javadsl.Flow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.Flow.statefulMapConcat(org.apache.pekko.japi.function.Creator)org.apache.pekko.stream.javadsl.Flow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.Flow.recoverWithRetries(Int,scala.PartialFunction)org.apache.pekko.stream.javadsl.Flow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.Source.statefulMapConcat(org.apache.pekko.japi.function.Creator)org.apache.pekko.stream.javadsl.Source")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubFlow.mapConcat(org.apache.pekko.japi.function.Function)org.apache.pekko.stream.javadsl.SubFlow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubFlow.statefulMapConcat(org.apache.pekko.japi.function.Creator)org.apache.pekko.stream.javadsl.SubFlow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubFlow.recoverWith(scala.PartialFunction)org.apache.pekko.stream.javadsl.SubFlow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubFlow.recoverWithRetries(Int,scala.PartialFunction)org.apache.pekko.stream.javadsl.SubFlow")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubSource.mapConcat(org.apache.pekko.japi.function.Function)org.apache.pekko.stream.javadsl.SubSource")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubSource.statefulMapConcat(org.apache.pekko.japi.function.Creator)org.apache.pekko.stream.javadsl.SubSource")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubSource.recoverWith(scala.PartialFunction)org.apache.pekko.stream.javadsl.SubSource")
ProblemFilters.exclude[IncompatibleSignatureProblem]("org.apache.pekko.stream.javadsl.SubSource.recoverWithRetries(Int,scala.PartialFunction)org.apache.pekko.stream.javadsl.SubSource")

# Take java.lang.Iterable instead of java.util.List for javadsl collections of graphs
